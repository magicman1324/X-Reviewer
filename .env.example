# ============================================
# X-Reviewer Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# ---- GitHub App (Required) ----
# From https://github.com/settings/apps → your App → General
APP_ID=123456
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=your_webhook_secret_here

# ---- GitHub App OAuth (Optional — for manifest flow) ----
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# ---- AI Provider (Required) ----
# DeepSeek API: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Logging ----
# Levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Set to "true" for structured JSON log output (useful in production)
LOG_JSON=false

# ---- Redis (Optional — for distributed deployment) ----
# When set, the review queue uses Redis/BullMQ instead of in-memory storage.
# REDIS_URL=redis://localhost:6379
